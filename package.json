{
  "name": "fitness-app",
  "main": "expo-router/entry",
  "version": "0.1.1",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write src package.json app.json eslint.config.js .github docs README.md PLAN.md AGENTS.md",
    "format:check": "prettier --check src package.json app.json eslint.config.js .github docs README.md PLAN.md AGENTS.md",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch",
    "test:ci": "jest --runInBand",
    "doctor": "npx expo-doctor",
    "bundle:ios": "expo export --platform ios --output-dir dist-ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.36",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "i18next": "^25.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^15.7.3",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "eslint-config-prettier": "^10.1.8",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "<rootDir>/fitness-app-scaffold/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "private": true
}
